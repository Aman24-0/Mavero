# Monorepo root ignores (workspace-wide).
# App-specific ignores (build/, .svelte-kit/, generated Netlify functions,
# DOM-QA harness artifacts, ...) live in apps/web/.gitignore.
node_modules/
.DS_Store
.env
.env.*
!.env.example
.vite/
.netlify/
coverage/
.cache/
# Phase 2-N: the project is pnpm-based (pnpm-lock.yaml is the active lockfile).
# package-lock.json (npm-format) is stale and not maintained — keep it out of
# the repo so it can't drift from pnpm-lock.yaml.
package-lock.json

# C# / Tizen .NET build artifacts (apps/tizen-native dotnet builds).
bin/
obj/
