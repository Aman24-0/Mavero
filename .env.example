# Development / staging / production public Supabase configuration
PUBLIC_SUPABASE_URL=https://your-mavero-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
PUBLIC_SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/

# Provider-neutral SvelteKit Node runtime
ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# Server-only resolver database access. Required for private templates; never expose or prefix with PUBLIC_.
# Server-only secret variable name: PRIVATE_SUPABASE_SERVICE_ROLE_KEY (set only in the deployment secret manager)

# Optional server-only content provider credentials. Never prefix these with PUBLIC_.
# Optional secret variable name: TMDB_BEARER_TOKEN (TMDB API Read Access Token; set only in the deployment secret manager)
# Backward-compatible server-only alternatives, if used by the deployment: TMDB_READ_ACCESS_TOKEN or TMDB_API_KEY
# Never prefix TMDB credentials with PUBLIC_ or expose them to browser code.
