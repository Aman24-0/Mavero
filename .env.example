# Development / staging / production public Supabase configuration
PUBLIC_SUPABASE_URL=https://your-mavero-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
PUBLIC_SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/

# Provider-neutral SvelteKit Node runtime
ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# Optional server-only content provider credentials. Never prefix these with PUBLIC_.
# TMDB_READ_ACCESS_TOKEN=your_server_only_tmdb_read_access_token
# TMDB_API_KEY=your_server_only_tmdb_api_key
