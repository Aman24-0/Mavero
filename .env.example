# Development / staging / production public Supabase configuration
PUBLIC_SUPABASE_URL=https://your-mavero-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
PUBLIC_SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/

# Provider-neutral SvelteKit Node runtime
ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# Server-only resolver database access. Required for private templates; never expose or prefix with PUBLIC_.
# Server-only secret variable name: PRIVATE_SUPABASE_SERVICE_ROLE_KEY (set only in the deployment secret manager)

# Optional server-only content provider credentials. Never prefix these with PUBLIC_.
# Optional secret variable name: TMDB_READ_ACCESS_TOKEN (set only in the deployment secret manager)
# Optional secret variable name: TMDB_API_KEY (set only in the deployment secret manager)

# Adult Mode guest preference cookie — HMAC-SHA256 signing secret (Phase 5).
# PRIVATE, server-only: never prefix with PUBLIC_, never expose to the client
# bundle, never commit a real value. REQUIRED in production for guest Adult
# Mode cookie issuance/verification (missing secret fails closed: guest
# preference is treated as OFF and no cookie can be issued). Generate with a
# strong random value, e.g.:  openssl rand -hex 32
# Optional secret variable name: MAVERO_ADULT_COOKIE_SECRET (set only in the deployment secret manager)

# MAVERO Player progressive addon resolution + compatibility tokens (Phase 10/11).
# HMAC-SHA256 signing secret for addon session tokens and signed compatibility
# references. PRIVATE, server-only. REQUIRED in production (missing secret
# fails closed: no sessions can be created). Generate with: openssl rand -hex 32
# Optional secret variable name: MAVERO_STREMIO_SESSION_SECRET (set only in the deployment secret manager)

# Optional independent secret for compatibility references (defaults to the
# session secret). If set, the media worker must be configured with THIS value.
# Optional secret variable name: MAVERO_COMPAT_SESSION_SECRET (set only in the deployment secret manager)

# Phase 11 (GOAL B) — dedicated FFmpeg compatibility media worker (apps/media-worker).
# HTTPS base URL of the worker deployment. When absent, conversion-required
# streams degrade to a typed COMPAT_UNAVAILABLE (never faked in serverless).
# MAVERO_MEDIA_WORKER_URL=https://media-worker.example.com
