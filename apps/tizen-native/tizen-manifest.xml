<?xml version="1.0" encoding="UTF-8"?>
<!-- Mavero TV — native Tizen .NET application manifest (TV profile, API 6.0).
     The internet privilege is required by ApiService (HttpClient calls to
     https://maveroweb.space). type="dotnet" + exec pointing at the managed
     entry assembly are what make the Tizen launcher boot the mono runtime. -->
<manifest xmlns="http://tizen.org/ns/packages"
          api-version="6.0"
          package="org.mavero.tv"
          version="0.0.1"
          install-location="internal-only">
    <profile name="tv" />
    <ui-application appid="org.mavero.tv"
                    exec="MaveroTv.dll"
                    type="dotnet"
                    multiple="false"
                    nodisplay="false"
                    taskid="0"
                    launch_mode="single">
        <label>Mavero TV</label>
        <icon>MaveroTv.png</icon>
    </ui-application>
    <privileges>
        <privilege>http://tizen.org/privilege/internet</privilege>
    </privileges>
    <feature name="http://tizen.org/feature/screen.size.all">true</feature>
</manifest>
