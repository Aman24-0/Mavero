<Project Sdk="Tizen.NET.Sdk/1.1.9">

  <!-- ============================================================
       Mavero TV — native Tizen .NET application (Tizen.NUI / C#).

       Why tizen60 and not net6.0-tizen/net8.0-tizen:
         Samsung's platform feature matrix ships the "Tizen .NET v2.1"
         profile (netstandard2.0, mono-based) on Tizen 4.0-6.0 TVs.
         The net6.0-tizen TFMs only exist from Tizen 7.0 (2023 models)
         onward, and Tizen .NET is deprecated for new TV models. To run
         on our target hardware (Tizen 6.0 TV) the classic tizen60 TFM
         with TizenFX API6 is the only workable choice.

       Why there is NO RuntimeIdentifier (emulator vs device):
         The classic tizen60 toolchain (Tizen.NET.Sdk 1.1.x) has no
         RID concept at all — verified in the Sdk's props/targets, which
         contain no RuntimeIdentifier/tizen-x86/tizen-armel anywhere.
         The tpk payload is pure managed IL plus resources, executed by
         the mono runtime that ships with the platform: x86 on the TV
         emulator, ARM on real hardware. Arch-specific RIDs
         (<RuntimeIdentifier>tizen-x86</RuntimeIdentifier>) belong to
         the net6.0-tizen+ AOT toolchain only, which TV 6.0 cannot run.

       Resources — where the visuals actually come from:
         Tizen.NET.Sdk 1.1.9 packs ONLY the project's res/, lib/ and
         shared/ folders (plus the publish output) into the tpk;
         <Content Include> items at the project root are silently
         ignored (verified against the Sdk's Packaging.targets and by
         unzipping a built tpk — res/ and shared/res/ were empty and
         the app rendered with no visuals at all). The layout that
         works:
           res/*.png           UI assets (9-patch surfaces, masks,
                               scrims) — packed to tpk res/, loaded at
                               runtime via Theme.AssetUrl() =
                               DirectoryInfo.Resource + file name
                               (Samsung's own TV-sample pattern; bare
                               relative URLs are not reliably resolved
                               by the DALi image loader)
           shared/res/*.png    launcher icon(s) — the location the
                               manifest <icon> entry is resolved from
         Do NOT move these files back to the project root.

       Build: requires the Tizen .NET toolchain (Tizen Studio / Visual
       Studio Tizen workload, or plain `dotnet build` — the Tizen.NET.Sdk
       NuGet package carries default author/distributor certificates for
       CI-style builds). The build output
       bin/Release/tizen60/org.mavero.tv-<version>.tpk installs on the
       Tizen TV emulator and on device.
       ============================================================ -->
  <PropertyGroup>
    <TargetFramework>tizen60</TargetFramework>
    <AssemblyName>MaveroTv</AssemblyName>
    <RootNamespace>MaveroTv</RootNamespace>
    <Version>0.0.2</Version>
    <!-- The explicit Tizen.NET reference below is REQUIRED by the classic
         tizen60 TFM (Tizen.NET.Sdk 1.1.9 predates implicit TizenFX refs;
         Samsung's tizen build-cs expects it). NETSDK1023 is emitted only by
         the modern desktop SDK used for verification builds and would
         otherwise be the sole warning in an otherwise clean build. -->
    <NoWarn>$(NoWarn);NETSDK1023</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- All TizenFX API 6 reference assemblies, incl. Tizen.NUI.
         Framework assemblies are provided by the platform runtime and
         are NOT packed into the tpk; only MaveroTv.dll and the
         third-party dependencies below are. -->
    <PackageReference Include="Tizen.NET" Version="6.0.0.14995" />
    <!-- JSON parsing. The Tizen v2.1 profile is netstandard2.0-based and
         does not bundle System.Text.Json, so we use the ecosystem-standard
         Newtonsoft.Json (Samsung's own Tizen samples use it). The Tizen
         SDK packs NuGet dependency assemblies into the tpk bin/ folder. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
