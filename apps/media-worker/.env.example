# REQUIRED — the HMAC secret that verifies signed compatibility references.
# MUST be the same secret the MAVERO app uses (MAVERO_COMPAT_SESSION_SECRET
# there, or the same MAVERO_STREMIO_SESSION_SECRET-derived value).
# Generate with: openssl rand -hex 32
MAVERO_COMPAT_SESSION_SECRET=

# RECOMMENDED (production) — the https base URL browsers use to reach this
# worker's HLS output, e.g. https://media-worker.your-domain.example
PUBLIC_BASE_URL=

# PORT (default 8787)
# MEDIA_WORKER_MAX_CONCURRENT_JOBS (default 2)
# MEDIA_WORKER_MAX_QUEUE_DEPTH (default 4)
# MEDIA_WORKER_MAX_OUTPUT_MB (default 4096)
# MEDIA_WORKER_MAX_INPUT_HOURS (default 6)
# MEDIA_WORKER_JOB_TTL_SECONDS (default 10800)
# MEDIA_WORKER_READY_WAIT_MS (default 8000)
# MEDIA_WORKER_CLEANUP_INTERVAL_MS (default 60000)
# MEDIA_WORKER_MIN_FREE_GB (default 2)
# FFMPEG_PATH / FFPROBE_PATH (default ffmpeg / ffprobe)
# LOG_LEVEL (default info; debug for development)
