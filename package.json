{
  "name": "mavero-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mavero/web dev",
    "build": "pnpm --filter @mavero/web build",
    "preview": "pnpm --filter @mavero/web preview",
    "start": "pnpm --filter @mavero/web start",
    "check": "pnpm --filter @mavero/web check",
    "lint": "pnpm --filter @mavero/web lint",
    "format": "pnpm --filter @mavero/web format",
    "format:check": "pnpm --filter @mavero/web format:check",
    "test": "pnpm --filter @mavero/web test"
  },
  "pnpm": {
    "overrides": {
      "hls.js": "1.7.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
