# EditorConfig — https://editorconfig.org
# Baseline conventions matching the existing codebase (LF, UTF-8, 2-space
# indentation, final newline). Editors apply this on save; no mass reformat
# is implied or scheduled by this file (cleanup Phase 2, canonical plan P2 item 8).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
